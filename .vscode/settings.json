{
    "cmake.configureOnOpen": true,
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.buildArgs": [
        "--target",
        "meganz_account_generator_cpp_cli"
    ],
    "cmake.configureSettings": {
        "CMAKE_TOOLCHAIN_FILE": "${workspaceFolder}/third_party/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "USE_OPENSSL": "ON",
        "VCPKG_MANIFEST_DIR": "${workspaceFolder}",
        "VCPKG_OVERLAY_PORTS": "${workspaceFolder}/third_party/meganz-sdk/cmake/vcpkg_overlay_ports",
        "VCPKG_OVERLAY_TRIPLETS": "${workspaceFolder}/cmake/vcpkg_overlay_triplets",
        "VCPKG_ROOT": "${workspaceFolder}/third_party/vcpkg",
        "VCPKG_TARGET_TRIPLET": "x64-windows-mega"
    }
}
